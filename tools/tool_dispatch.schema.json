{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.maivn.dev/tools/tool_dispatch.schema.json",
  "title": "ToolDispatch",
  "description": "JSON-only external tool delivery envelope. It never carries callable code, source, modules, artifacts, images, commands, pickles, packages, or secret fields.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dispatch_id", "attempt_id", "attempt", "organization_id", "project_id", "agent_id", "agent_version", "execution_mode", "session_id", "call_id", "tool_id", "tool_name", "arguments", "idempotency", "timeout_ms", "created_at", "deadline_at", "response_mode"],
  "properties": {
    "schema_version": {"const": 1}, "dispatch_id": {"type": "string", "minLength": 1}, "attempt_id": {"type": "string", "minLength": 1}, "attempt": {"type": "integer", "minimum": 1}, "organization_id": {"type": "string", "minLength": 1}, "project_id": {"type": "string", "minLength": 1}, "agent_id": {"type": "string", "minLength": 1}, "agent_version": {"type": "integer", "minimum": 1}, "execution_mode": {"type": "string", "enum": ["worker", "webhook"]}, "session_id": {"type": "string", "minLength": 1}, "call_id": {"type": "string", "minLength": 1}, "tool_id": {"type": "string", "minLength": 1}, "tool_name": {"type": "string", "minLength": 1}, "arguments": {"type": "object"}, "idempotency": {"type": "string", "enum": ["idempotent", "non_idempotent", "unknown"]}, "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 600000}, "created_at": {"type": "string", "format": "date-time"}, "deadline_at": {"type": "string", "format": "date-time"}, "response_mode": {"type": "string", "enum": ["sync", "async"]}, "callback_url": {"type": "string", "format": "uri"}, "callback_token": {"type": "string", "minLength": 1}, "extensions": {"type": "object", "additionalProperties": {}}
  }
}
