[
  {
    "trigger_id": "trg-daily-digest",
    "project_id": "prj-support",
    "name": "Daily support digest",
    "status": "enabled",
    "source": {
      "kind": "schedule",
      "phase": "phase_1",
      "cron": "0 9 * * *",
      "jitter_seconds": 60
    },
    "binding": {
      "kind": "template",
      "messages": [
        "Build the daily support digest for {{event.window.date}}."
      ]
    },
    "agent": {
      "agent_id": "agt-support-digest",
      "version": 3
    },
    "options": {
      "concurrency": 4,
      "retry_policy": {
        "max_attempts": 3,
        "initial_delay_seconds": 30,
        "max_delay_seconds": 3600,
        "backoff": "exponential"
      },
      "dedupe_window_seconds": 86400,
      "depth_cap": 8,
      "fanout_cap": 100,
      "shadow": false,
      "fire_budget": 5
    },
    "scenario_id": "scn-daily-support-digest",
    "created_at": "2026-07-01T18:00:00Z",
    "updated_at": "2026-07-01T18:00:00Z"
  },
  {
    "trigger_id": "trg-support-webhook",
    "project_id": "prj-support",
    "name": "High-priority support webhook",
    "status": "enabled",
    "source": {
      "kind": "webhook",
      "phase": "phase_1",
      "secret_ref": "vault://project/prj-support/trigger/trg-support-webhook/hmac"
    },
    "filter": "$.case[?(@.priority == 'high')]",
    "binding": {
      "kind": "template",
      "messages": [
        "New high-priority case {{event.case.id}} from {{event.customer.email}}.",
        "Summarize the customer's issue and recommend the next action."
      ]
    },
    "agent": {
      "agent_id": "agt-customer-triage",
      "version": "latest"
    },
    "options": {
      "concurrency": 4,
      "retry_policy": {
        "max_attempts": 3,
        "initial_delay_seconds": 30,
        "max_delay_seconds": 3600,
        "backoff": "exponential"
      },
      "dedupe_window_seconds": 86400,
      "depth_cap": 8,
      "fanout_cap": 100,
      "shadow": false,
      "fire_budget": 5
    },
    "scenario_id": "scn-customer-triage",
    "created_at": "2026-07-01T18:05:00Z",
    "updated_at": "2026-07-01T18:05:00Z"
  },
  {
    "trigger_id": "trg-manual-replay",
    "project_id": "prj-support",
    "name": "Manual replay",
    "status": "paused",
    "source": {
      "kind": "manual",
      "phase": "phase_1"
    },
    "binding": {
      "kind": "callable",
      "module_path": "support.scenarios.bindings",
      "qualified_name": "build_replay_messages",
      "content_hash": "sha256:abcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcdefabcd"
    },
    "agent": {
      "agent_id": "agt-replay",
      "version": 1
    },
    "created_at": "2026-07-01T18:10:00Z",
    "updated_at": "2026-07-01T18:10:00Z"
  },
  {
    "trigger_id": "trg-chained-summary",
