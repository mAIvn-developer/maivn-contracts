    "binding": {
      "kind": "template",
      "messages": [
        "Escalate SLA timer {{event.timer_id}} for {{event.instance_key}}."
      ]
    },
    "agent": {
      "agent_id": "agt-customer-triage",
      "version": 4
    },
    "created_at": "2026-07-01T18:45:00Z",
