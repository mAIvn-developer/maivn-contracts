["model","ArtifactStorageRef",{"validation":{"schema":{"additionalProperties":false,"description":"Storage bucket/path pointer for a derived artifact body.","properties":{"bucket":{"description":"Storage bucket, grounded in v1 storage_bucket.","minLength":1,"title":"Bucket","type":"string"},"path":{"description":"Storage object path, grounded in v1 storage_path.","minLength":1,"title":"Path","type":"string"}},"required":["bucket","path"],"title":"ArtifactStorageRef","type":"object"}},"serialization":"<same as validation>"}]
["model","DerivedArtifact",{"validation":{"schema":{"additionalProperties":false,"description":"Produced artifact record for resource-processing outputs.","properties":{"artifact_id":{"description":"Stable artifact id.","minLength":1,"title":"Artifact Id","type":"string"},"resource_id":{"description":"Registered resource id.","minLength":1,"title":"Resource Id","type":"string"},"kind":{"description":"Produced artifact kind.","enum":["markdown","redacted_markdown","redacted_image","sidecar_map"],"title":"Kind","type":"string"},"storage_ref":{"anyOf":[{"$ref":"#/$defs/ArtifactStorageRef"},{"type":"null"}],"default":null,"description":"Storage reference for large artifact bodies."},"inline_text":{"anyOf":[{"maxLength":262144,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Bounded inline artifact body.","title":"Inline Text"},"content_hash":{"description":"SHA-256 hex digest of the artifact body.","pattern":"^[0-9a-f]{64}$","title":"Content Hash","type":"string"},"conversion_method":{"description":"Internal conversion method name.","minLength":1,"title":"Conversion Method","type":"string"},"ocr_confidence":{"anyOf":[{"maximum":1,"minimum":0,"type":"number"},{"type":"null"}],"default":null,"description":"Optional OCR confidence score from 0 through 1.","title":"Ocr Confidence"},"version":{"description":"Positive artifact version number.","minimum":1,"title":"Version","type":"integer"},"supersedes_artifact_id":{"anyOf":[{"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Optional prior artifact replaced by this version.","title":"Supersedes Artifact Id"},"version_stamps":{"$ref":"#/$defs/VersionStamps","description":"Artifact lineage version stamps."},"created_at":{"description":"RFC3339 creation timestamp.","title":"Created At","type":"string"}},"required":["artifact_id","resource_id","kind","content_hash","conversion_method","version","version_stamps","created_at"],"title":"DerivedArtifact","type":"object"}},"serialization":"<same as validation>"}]
["model","ProcessingState",{"validation":{"schema":{"additionalProperties":false,"description":"Resource processing lifecycle record.","properties":{"resource_id":{"description":"Registered resource id.","minLength":1,"title":"Resource Id","type":"string"},"tier":{"description":"Resolved resource processing tier.","enum":["direct","indexed","secure"],"title":"Tier","type":"string"},"status":{"description":"Processing lifecycle status.","enum":["pending","processing","ready","failed","quarantined","redaction_failed"],"title":"Status","type":"string"},"processed_at":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"RFC3339 processing timestamp, or null before processing evidence exists.","title":"Processed At"},"attempt":{"description":"Zero-based processing attempt count.","minimum":0,"title":"Attempt","type":"integer"},"error":{"anyOf":[{"maxLength":1024,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Optional non-sensitive error summary.","title":"Error"},"version_stamps":{"$ref":"#/$defs/VersionStamps","description":"Artifact lineage version stamps."}},"required":["resource_id","tier","status","processed_at","attempt","version_stamps"],"title":"ProcessingState","type":"object"}},"serialization":"<same as validation>"}]
["model","ResourcePolicy",{"validation":{"schema":{"additionalProperties":false,"description":"Intent-level resource processing policy.","properties":{"resource":{"anyOf":[{"$ref":"#/$defs/Attachment"},{"type":"string"}],"description":"Attachment entity or registered resource_id to process.","title":"Resource"},"tier":{"anyOf":[{"enum":["direct","indexed","secure"],"type":"string"},{"type":"null"}],"description":"Requested tier, or null to derive from the carrying message.","title":"Tier"},"persist":{"anyOf":[{"type":"boolean"},{"type":"null"}],"description":"Durability intent, or null for the smart default.","title":"Persist"}},"required":["resource","tier","persist"],"title":"ResourcePolicy","type":"object"}},"serialization":"<same as validation>"}]
["model","VersionStamps",{"validation":{"schema":"=def"},"serialization":"<same as validation>"}]
["export","ArtifactKind",{"validation":{"schema":{"enum":["markdown","redacted_markdown","redacted_image","sidecar_map"],"type":"string"}},"serialization":"<same as validation>"}]
["export","ProcessingStatus",{"validation":{"schema":{"enum":["pending","processing","ready","failed","quarantined","redaction_failed"],"type":"string"}},"serialization":"<same as validation>"}]
["export","ResourceTier",{"validation":{"schema":{"enum":["direct","indexed","secure"],"type":"string"}},"serialization":"<same as validation>"}]
