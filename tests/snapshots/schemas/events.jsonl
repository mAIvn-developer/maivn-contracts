["model","Event",{"validation":{"schema":{"additionalProperties":false,"description":"Canonical Event wire record.","properties":{"event_id":{"description":"Stable unique identifier for this event record.","examples":["evt-01HY3K75PN8JMEQ5W1N6JAFM4C"],"minLength":1,"title":"Event Id","type":"string"},"ordinal":{"description":"Per-producer monotonic or hybrid-logical-clock token; it is not a global gapless database sequence.","examples":["producer-agent-000001"],"minLength":1,"title":"Ordinal","type":"string"},"type":{"description":"Canonical event type from the event taxonomy.","enum":["tool_event","interrupt_request","interrupt_required","assignment_received","assignment_completed","model_tool_complete","heartbeat","update","progress_update","model_routing","status_message","status_message_chunk","final","error","system_tool_start","system_tool_chunk","system_tool_complete","system_tool_error","hook_fired","enrichment","evaluating","planning","searching_tools","loading_tools","planning_assignments","executing_assignments","executing_actions","synthesizing","finalizing","reevaluate_accrued","memory_summarizing","memory_summarized","memory_retrieving","memory_retrieved","memory_indexing","memory_indexed","memory_graph_extracting","memory_skill_extracting","memory_insight_extracting","memory_skill_extracted","memory_insight_extracted","redaction_previewed","message_redaction_applied","resource_registering","resource_registered","resource_dedup_reused","resource_version_superseded","resource_extracting","resource_extracted","document_analysis_selected","document_evidence_coverage","trigger.fired","trigger.skipped","trigger.failed","trigger.disabled","trigger.enabled","connection.event_received","email.received","conversation.reply_received","memory.record_changed","storage.object_uploaded","trigger.fire_requested","agent.thinking","agent.tool_selected","tool.dispatch_started","tool.dispatch_completed","agent.responded","session.completed","artifact.reserved","artifact.uploaded","artifact.validation_started","artifact.validated","artifact.available","artifact.rejected","artifact.failed","artifact.selected","artifact.delivery_queued","artifact.delivery_started","artifact.delivery_succeeded","artifact.delivery_failed","artifact.expired","artifact.deletion_requested","artifact.deletion_started","artifact.deletion_pending_backup_expiry","artifact.deleted","artifact.delete_incomplete","artifact.vault_authorization_pending","artifact.vault_authorization_denied","artifact.vault_render_started","artifact.vault_render_failed"],"examples":["planning"],"title":"Type","type":"string"},"session_id":{"description":"Invocation or session identifier that owns this event.","examples":["ses-fire-0001"],"minLength":1,"title":"Session Id","type":"string"},"scenario_id":{"anyOf":[{"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Optional scenario identifier when the event belongs to a deployed scenario.","examples":["scn-customer-email-triage"],"title":"Scenario Id"},"trigger_id":{"anyOf":[{"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Optional trigger identifier when the event was caused by a trigger fire.","examples":["trg-inbound-email"],"title":"Trigger Id"},"root_event_id":{"description":"Root event identifier for cross-fire lineage and trigger-chain correlation.","examples":["evt-trigger-fired-0001"],"minLength":1,"title":"Root Event Id","type":"string"},"parent_session_id":{"anyOf":[{"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Optional parent session identifier for chained or nested invocations.","examples":["ses-fire-parent"],"title":"Parent Session Id"},"parent_trigger_id":{"anyOf":[{"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Optional parent trigger identifier for chained trigger invocations.","examples":["trg-inbound-email"],"title":"Parent Trigger Id"},"trigger_chain_depth":{"description":"Depth of the trigger chain used for amplification guards and trace correlation.","examples":[1],"minimum":0,"title":"Trigger Chain Depth","type":"integer"},"parent_assignment_uuid":{"anyOf":[{"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Optional parent assignment UUID for faithful swarm and nested-job reconstruction.","examples":["assign-parent-0005"],"title":"Parent Assignment Uuid"},"job_depth":{"description":"Execution-tree depth carried from build_config for nested assignment replay.","examples":[2],"minimum":0,"title":"Job Depth","type":"integer"},"job_index":{"description":"Execution-tree sibling index carried from build_config for causal ordering.","examples":[1],"minimum":0,"title":"Job Index","type":"integer"},"actor":{"description":"Agent, node, trigger, or tool that emitted the event.","examples":["agent:triage"],"minLength":1,"title":"Actor","type":"string"},"mode":{"description":"Execution mode used for tool dispatch and canvas painting.","enum":["worker","webhook","hosted"],"examples":["hosted"],"title":"Mode","type":"string"},"correlation_id":{"anyOf":[{"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Optional per-tool correlation identifier assigned at dispatch.","examples":["tool-call-0003"],"title":"Correlation Id"},"trace_id":{"anyOf":[{"pattern":"^[0-9a-f]{32}$","type":"string"},{"type":"null"}],"default":null,"description":"Optional W3C/OpenTelemetry trace identifier for internal span correlation.","examples":["4bf92f3577b34da6a3ce929d0e0e4736"],"title":"Trace Id"},"payload":{"additionalProperties":true,"description":"Type-specific open payload for inspector rendering, inputs, outputs, and schemas.","examples":[{"phase":"planning"}],"title":"Payload","type":"object"},"latency_ms":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"description":"Optional elapsed latency in milliseconds for connector animation and observability.","examples":[184],"title":"Latency Ms"},"ts":{"description":"RFC3339 timestamp for when the event was emitted.","examples":["2026-07-01T14:00:00Z"],"title":"Ts","type":"string"}},"required":["event_id","ordinal","type","session_id","root_event_id","trigger_chain_depth","job_depth","job_index","actor","mode","payload","ts"],"title":"Event","type":"object"}},"serialization":"<same as validation>"}]
["model","RecursiveSessionTrace",{"validation":{"schema":{"additionalProperties":false,"description":"`SessionTrace` for the recursive assembly path - `truncated` is required.\n\nA `SessionTrace` never lies about truncation because it never claims to be\ncomplete: the field simply does not exist there. Only the recursive assembler,\nwhich actually enforces descendant-session and event caps, is allowed to say\nwhether it cut the tree short.","properties":{"session_id":{"minLength":1,"title":"Session Id","type":"string"},"root":{"$ref":"#/$defs/TraceNode"},"truncated":{"description":"True when a descendant-session or event cap cut the assembled tree short.","title":"Truncated","type":"boolean"}},"required":["session_id","root","truncated"],"title":"RecursiveSessionTrace","type":"object"}},"serialization":"<same as validation>"}]
["model","ReplayCoverage",{"validation":{"schema":{"additionalProperties":false,"description":"Durable position span and explicit reasons for omitted events.","properties":{"first_position":{"anyOf":[{"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"First Position"},"last_position":{"anyOf":[{"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Last Position"},"dropped_count_by_reason":{"additionalProperties":{"type":"integer"},"title":"Dropped Count By Reason","type":"object"}},"title":"ReplayCoverage","type":"object"}},"serialization":"<same as validation>"}]
["model","ReplayFrame",{"validation":{"schema":{"additionalProperties":false,"description":"One position-bearing, payload-curated visible timeline frame.","properties":{"event_id":{"minLength":1,"title":"Event Id","type":"string"},"position":{"minimum":1,"title":"Position","type":"integer"},"ts":{"minLength":1,"title":"Ts","type":"string"},"kind":{"enum":["tool_event","interrupt_request","interrupt_required","assignment_received","assignment_completed","model_tool_complete","progress_update","model_routing","status_message","final","error","system_tool_start","system_tool_complete","system_tool_error","redaction_previewed","message_redaction_applied","trigger.fired","trigger.skipped","trigger.failed","trigger.disabled","trigger.enabled","tool.dispatch_started","tool.dispatch_completed","session.completed"],"title":"Kind","type":"string"},"actor":{"minLength":1,"title":"Actor","type":"string"},"summary":{"additionalProperties":{"anyOf":[{"type":"integer"},{"type":"boolean"},{"type":"string"}]},"title":"Summary","type":"object"},"lineage":{"$ref":"#/$defs/ReplayLineage"}},"required":["event_id","position","ts","kind","actor","lineage"],"title":"ReplayFrame","type":"object"}},"serialization":"<same as validation>"}]
["model","ReplayLineage",{"validation":{"schema":"=def"},"serialization":"<same as validation>"}]
["model","SessionAuditLog",{"validation":{"schema":{"additionalProperties":false,"description":"The ordered audit projection for a session's canonical event family.","properties":{"session_id":{"minLength":1,"title":"Session Id","type":"string"},"entries":{"items":{"$ref":"#/$defs/AuditEntry"},"title":"Entries","type":"array"}},"required":["session_id"],"title":"SessionAuditLog","type":"object"}},"serialization":"<same as validation>"}]
["model","SessionReplay",{"validation":{"schema":{"additionalProperties":false,"description":"The curated, ordered replay and its durable coverage metadata.","properties":{"session_id":{"minLength":1,"title":"Session Id","type":"string"},"frames":{"items":{"$ref":"#/$defs/ReplayFrame"},"title":"Frames","type":"array"},"coverage":{"$ref":"#/$defs/ReplayCoverage"}},"required":["session_id","coverage"],"title":"SessionReplay","type":"object"}},"serialization":"<same as validation>"}]
["model","SessionTrace",{"validation":{"schema":{"additionalProperties":false,"description":"The assembled trace for one session and its delegated children.\n\nSingle-level shape only - this model is unchanged from its pre-S6 form and its\nserialization is byte-identical to before. The recursive `/v1/sessions/{id}/trace`\nendpoint uses `RecursiveSessionTrace` below instead of adding a field here, so\nevery existing single-level caller (data-plane session trace, control-plane\n`/v1/runs/{id}/trace`) keeps emitting exactly the same bytes it always has.","properties":{"session_id":{"minLength":1,"title":"Session Id","type":"string"},"root":{"$ref":"#/$defs/TraceNode"}},"required":["session_id","root"],"title":"SessionTrace","type":"object"}},"serialization":"<same as validation>"}]
