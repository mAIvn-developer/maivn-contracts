["model","AuditEntry",{"validation":{"schema":{"additionalProperties":false,"description":"One security-curated, payload-safe record in a session audit log.","properties":{"event_id":{"minLength":1,"title":"Event Id","type":"string"},"actor":{"minLength":1,"title":"Actor","type":"string"},"action":{"minLength":1,"title":"Action","type":"string"},"resource":{"minLength":1,"title":"Resource","type":"string"},"outcome":{"minLength":1,"title":"Outcome","type":"string"},"reason_code":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Reason Code"},"ts":{"minLength":1,"title":"Ts","type":"string"},"lineage":{"$ref":"#/$defs/AuditLineage"},"details":{"additionalProperties":{"anyOf":[{"type":"integer"},{"type":"boolean"},{"type":"string"}]},"title":"Details","type":"object"}},"required":["event_id","actor","action","resource","outcome","ts","lineage"],"title":"AuditEntry","type":"object"}},"serialization":"<same as validation>"}]
