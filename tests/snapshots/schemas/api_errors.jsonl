["model","ApiErrorBody",{"validation":{"schema":{"additionalProperties":false,"description":"The typed error body shared by every public API reply.","properties":{"detail":{"description":"Human-readable message.","minLength":1,"title":"Detail","type":"string"},"code":{"description":"Stable machine-readable code.","pattern":"^[a-z][a-z0-9_]*$","title":"Code","type":"string"},"fields":{"anyOf":[{"items":{"$ref":"#/$defs/ApiErrorField"},"type":"array"},{"type":"null"}],"default":null,"description":"Request fields that failed validation.","title":"Fields"},"retry_after":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"description":"Seconds to wait before retrying; mirrors the Retry-After header.","title":"Retry After"},"context":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"default":null,"description":"Public, code-specific data a client can act on.","title":"Context"},"request_id":{"anyOf":[{"minLength":1,"type":"string"},{"type":"null"}],"default":null,"description":"Opaque id of the request, for support.","title":"Request Id"}},"required":["detail","code"],"title":"ApiErrorBody","type":"object"}},"serialization":"<same as validation>"}]
["model","ApiErrorField",{"validation":{"schema":"=def"},"serialization":"<same as validation>"}]
