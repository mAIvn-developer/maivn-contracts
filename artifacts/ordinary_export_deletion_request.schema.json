{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.maivn.dev/artifacts/ordinary_export_deletion_request.schema.json",
  "title": "OrdinaryExportDeletionRequest",
  "x-maivn-verified-export-validation": "deletion-request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ordinary_deletion_ref", "deletion_manifest_id"],
  "properties": {
    "schema_version": {"const": "ordinary-export-deletion-request-v1"},
    "ordinary_deletion_ref": {"$ref": "#/$defs/token"},
    "deletion_manifest_id": {"$ref": "#/$defs/token"}
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}
  }
}
