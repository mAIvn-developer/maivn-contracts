{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.maivn.dev/artifacts/artifact_reservation.schema.json",
  "title": "ArtifactReservation",
  "type": "object",
  "additionalProperties": false,
  "required": ["reservation_id", "organization_id", "project_id", "root_invocation_id", "producing_session_id", "tool_call_id", "dispatch_id", "attempt_id", "producer", "logical_output_id", "allowed_kinds", "allowed_mime_types", "max_artifact_count", "max_total_bytes", "retention_policy_snapshot_id", "idempotency_key", "expires_at", "state"],
  "properties": {
    "reservation_id": {"$ref": "https://schemas.maivn.dev/artifacts/artifact_ref.schema.json#/$defs/tokenId"},
    "organization_id": {"$ref": "https://schemas.maivn.dev/artifacts/artifact_ref.schema.json#/$defs/tokenId"},
    "project_id": {"$ref": "https://schemas.maivn.dev/artifacts/artifact_ref.schema.json#/$defs/tokenId"},
    "root_invocation_id": {"$ref": "https://schemas.maivn.dev/artifacts/artifact_ref.schema.json#/$defs/tokenId"},
    "producing_session_id": {"$ref": "https://schemas.maivn.dev/artifacts/artifact_ref.schema.json#/$defs/tokenId"},
    "tool_call_id": {"$ref": "https://schemas.maivn.dev/artifacts/artifact_ref.schema.json#/$defs/tokenId"},
    "dispatch_id": {"$ref": "https://schemas.maivn.dev/artifacts/artifact_ref.schema.json#/$defs/tokenId"},
    "attempt_id": {"$ref": "https://schemas.maivn.dev/artifacts/artifact_ref.schema.json#/$defs/tokenId"},
    "producer": {"$ref": "https://schemas.maivn.dev/artifacts/artifact_ref.schema.json#/$defs/producerLineage"},
    "logical_output_id": {"$ref": "https://schemas.maivn.dev/artifacts/artifact_ref.schema.json#/$defs/tokenId"},
    "allowed_kinds": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "https://schemas.maivn.dev/artifacts/artifact_ref.schema.json#/$defs/artifactKind"}},
    "allowed_mime_types": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "https://schemas.maivn.dev/artifacts/artifact_ref.schema.json#/$defs/mimeType"}},
    "max_artifact_count": {"type": "integer", "minimum": 1},
    "max_total_bytes": {"type": "integer", "minimum": 1},
    "retention_policy_snapshot_id": {"$ref": "https://schemas.maivn.dev/artifacts/artifact_ref.schema.json#/$defs/tokenId"},
    "idempotency_key": {"$ref": "https://schemas.maivn.dev/artifacts/artifact_ref.schema.json#/$defs/tokenId"},
    "expires_at": {"$ref": "https://schemas.maivn.dev/artifacts/artifact_ref.schema.json#/$defs/rfc3339UtcTimestamp"},
    "state": {"enum": ["reserved", "uploading", "validating", "finalized", "rejected", "expired", "failed"]},
    "outcome": {"allOf": [{"$ref": "https://schemas.maivn.dev/artifacts/artifact_ref.schema.json#/$defs/ordinaryArtifactRef"}, {"properties": {"state": {"const": "available"}}}]}
  },
  "allOf": [
    {"if": {"properties": {"allowed_mime_types": {"contains": {"enum": ["application/pdf", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"]}}}}, "then": {"properties": {"allowed_kinds": {"contains": {"const": "document"}}}}},
    {"if": {"properties": {"allowed_mime_types": {"contains": {"const": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"}}}}, "then": {"properties": {"allowed_kinds": {"contains": {"const": "spreadsheet"}}}}},
    {"if": {"properties": {"allowed_mime_types": {"contains": {"enum": ["image/png", "image/jpeg"]}}}}, "then": {"properties": {"allowed_kinds": {"contains": {"const": "image"}}}}},
    {"if": {"properties": {"allowed_mime_types": {"contains": {"enum": ["audio/mpeg", "audio/wav"]}}}}, "then": {"properties": {"allowed_kinds": {"contains": {"const": "audio"}}}}},
    {"if": {"properties": {"allowed_mime_types": {"contains": {"const": "application/octet-stream"}}}}, "then": {"properties": {"allowed_kinds": {"contains": {"const": "other"}}}}},
    {"if": {"properties": {"state": {"const": "finalized"}}}, "then": {"required": ["outcome"]}, "else": {"not": {"required": ["outcome"]}}}
  ]
}
