{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.maivn.dev/artifacts/vault_ordinary_export_service_assertion.schema.json",
  "title": "VaultOrdinaryExportServiceAssertion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issuer",
    "key_id",
    "audience",
    "role",
    "method",
    "fixed_path",
    "request_binding",
    "issued_at",
    "expires_at",
    "nonce"
  ],
  "properties": {
    "schema_version": {"const": "vault-ordinary-export-assertion-v1"},
    "issuer": {"$ref": "#/$defs/token"},
    "key_id": {"$ref": "#/$defs/token"},
    "audience": {"const": "maivn-data-plane-ordinary-export-v1"},
    "role": {"enum": ["executor", "maintenance"]},
    "method": {"const": "POST"},
    "fixed_path": {"enum": [
      "/internal/v1/vault/ordinary-exports/publications",
      "/internal/v1/vault/ordinary-exports/deletions",
      "/internal/v1/vault/ordinary-exports/deletion-status"
    ]},
    "request_binding": {"$ref": "#/$defs/sha256Hex"},
    "issued_at": {"$ref": "#/$defs/timestamp"},
    "expires_at": {"$ref": "#/$defs/timestamp"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{22}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "executor"}}, "required": ["role"]},
      "then": {"properties": {"fixed_path": {"const": "/internal/v1/vault/ordinary-exports/publications"}}}
    },
    {
      "if": {"properties": {"role": {"const": "maintenance"}}, "required": ["role"]},
      "then": {"properties": {"fixed_path": {"enum": [
        "/internal/v1/vault/ordinary-exports/deletions",
        "/internal/v1/vault/ordinary-exports/deletion-status"
      ]}}}
    }
  ],
  "$defs": {
    "token": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "sha256Hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    }
  }
}
