      "type": "integer"
    },
    "steps_used": {
      "minimum": 0,
      "title": "Steps Used",
      "type": "integer"
    },
    "max_expense_usd": {
      "title": "Max Expense Usd",
      "type": "string"
    },
    "progress_position": {
