    "result": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    }
  },
  "required": [
    "session_id",
    "state",
    "deadline_at",
    "max_steps",
    "steps_used",
    "max_expense_usd"
  ],
  "title": "HostedJobStatus",
  "type": "object"
