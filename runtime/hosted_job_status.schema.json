            "steps_exhausted",
            "budget_exhausted",
            "start_failed",
            "authorization_revoked"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Terminal Reason"
    },
    "deadline_at": {
      "title": "Deadline At",
      "type": "string"
    },
    "max_steps": {
