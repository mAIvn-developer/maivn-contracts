{
  "_meta": {
    "name": "audit",
    "version": "0.1.0",
    "lossy": true,
    "note": "Security-relevant audit projection. Entries retain only actor, action, resource, outcome, safe reason codes, timestamps, lineage, and explicitly allowlisted scalar counts, booleans, or machine codes. Raw payloads, messages, prompts, values, and user content never enter the audit log.",
    "reserved_future_actions": [
      "api_key.issued",
      "api_key.revoked",
      "approval.approved",
      "approval.rejected",
      "auth.session_ended",
      "auth.session_started",
      "breakglass.used",
      "config.changed",
      "flag.changed",
      "privacy.redaction_failed",
      "quota.denied",
      "spend.denied",
      "trigger.admitted",
      "trigger.rejected",
      "webhook.delivery_failed"
    ],
    "reserved_note": "Audit actions reserved for event types not yet on the spine (api keys, auth sessions, approvals, breakglass, config/flag changes, quota/spend denials, webhook delivery failures). Add the vocabulary event first, then promote the mapping out of this list."
  },
  "target_events": [
    "audit.entry"
  ],
  "mappings": {
    "connection.event_received": {
      "target": "audit.entry",
      "action": "connection.event_received",
